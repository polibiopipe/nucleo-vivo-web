{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/move-assistant.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "redirects": [
    {
      "source": "/lab/umbral-docente/app/",
      "destination": "https://psicoldp.org/umbral/",
      "permanent": false
    },
    {
      "source": "/lab/umbral-docente/app/:path*",
      "destination": "https://psicoldp.org/umbral/",
      "permanent": false
    }
  ]
}
