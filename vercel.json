{
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/move-assistant.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/msc-assistant.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/msc-invoice.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/msc-gestion.mjs": {
      "maxDuration": 10,
      "includeFiles": "prototipos/msc-safety/gestion/**"
    },
    "api/msc-activate.mjs": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/msc-customer-enrich.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    },
    "api/msc-customer-tools.mjs": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/msc-sales.mjs": {
      "maxDuration": 10,
      "includeFiles": "prototipos/msc-safety/ventas/**"
    },
    "api/msc-transport.mjs": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/lab/umbral-docente/app/",
      "destination": "https://psicoldp.org/umbral/",
      "permanent": false
    },
    {
      "source": "/lab/umbral-docente/app/:path*",
      "destination": "https://psicoldp.org/umbral/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/prototipos/msc-safety/gestion",
      "destination": "/api/msc-gestion"
    },
    {
      "source": "/prototipos/msc-safety/gestion/",
      "destination": "/api/msc-gestion"
    },
    {
      "source": "/prototipos/msc-safety/ventas",
      "destination": "/api/msc-sales"
    },
    {
      "source": "/prototipos/msc-safety/ventas/",
      "destination": "/api/msc-sales"
    },
    {
      "source": "/prototipos/msc-safety/ventas/index.html",
      "destination": "/api/msc-sales"
    },
    {
      "source": "/prototipos/msc-safety/transporte",
      "destination": "/api/msc-transport"
    },
    {
      "source": "/prototipos/msc-safety/transporte/",
      "destination": "/api/msc-transport"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/prototipos/msc-safety/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://ygfmpwlpmaasooltjujb.supabase.co; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/msc-:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
